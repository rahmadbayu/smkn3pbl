# GEMINI_API_KEY: Required for optional Gemini AI features (News Assistant & Public Info Chatbot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ADMIN_INITIAL_PASSWORD: Optional initial Super Administrator password.
# Leave empty in preview to use the inline First-Run Admin Claim form on /admin.
ADMIN_INITIAL_PASSWORD=""

# SESSION_SECRET: Optional HMAC secret for signing session tokens (falls back to random in-memory secret).
SESSION_SECRET=""
